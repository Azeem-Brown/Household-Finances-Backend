{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=household_finances;"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "HouseholdFinances",
      "Audience": "HouseholdFinances.Api",
      "RefreshAudience": "HouseholdFinances.Api.Refresh",
      "AccessTokenLifetimeMinutes": 30,
      "RefreshTokenLifetimeDays": 7
    },
    "Google": {
      "ClientId": ""
    }
  }
}
